{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "*.ts",
      "release/**/*.ts",
      "release/**/*.js",
      "site/*.ts",
      "site/get/*.ts",
      "relay/**/*.ts",
      "packages/**/*.ts",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "!**/node_modules",
      "!**/dist"
    ]
  }
}
